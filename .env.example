# Copy to .env (gitignored) and fill in. Placeholders only: defaults live in
# src/server/settings.ts, and real values never enter a tracked file.

# The transcript folder the server writes, as a Windows path.
TRANSCRIPT_DIR=C:\Users\<you>\path\to\transcripts

# The model server's base URL; /metrics is read from its root.
METRICS_URL=http://<model-server>:<port>

# Optional: the NAME of an environment variable holding a bearer token for /metrics.
# Never the token itself.
METRICS_TOKEN_ENV=

# Each cluster node, comma-separated: name=user@host (add :port when it is not 22).
NODES=<name>=<user>@<host>

# The dedicated SSH key that can run only the stats command, and the file pinning each
# node's host key. Both live outside the repo.
NODE_KEY=C:\Users\<you>\.ssh\<tracker-key>
NODE_KNOWN_HOSTS=C:\Users\<you>\.ssh\<tracker-known-hosts>

# Extra Host names to accept, such as the overlay VPN's name for this machine.
ALLOWED_HOSTS=

# Optional overrides; leave unset to use the defaults in src/server/settings.ts.
# TRACKER_PORT=
# QUIET_AFTER_SECONDS=
# STREAMS_POLL_SECONDS=
# FOLLOW_POLL_SECONDS=
# METRICS_POLL_SECONDS=
# NODES_POLL_SECONDS=
# HISTORY_WINDOW_SECONDS=
